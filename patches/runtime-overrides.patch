 /* ---------- gen-time hooks ---------- */
 
 int psx_datashard_enter(CPUState* cpu, uint32_t key) {
+    /* Shadow Tower: a resident hand-written override replaces the body. Its
+     * memory traffic bypasses the recorder, so an enclosing capture is void. */
+    extern int shadowtower_function_override(CPUState *cpu, uint32_t address);
+    if (shadowtower_function_override(cpu, key)) {
+        ds_poison(5);
+        return 1;
+    }
     if (!s_enabled) return 0;
     s_st.enters++; s_st.last_key = key;
 

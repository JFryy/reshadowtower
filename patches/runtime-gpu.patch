  * any widescreen adjustment already applied by the caller. */
+ShadowtowerTriangleExtra g_shadowtower_triangle_extra;
+
+/* Gouraud primitives (GP0 bit 28) keep each vertex colour in the word before
+ * its position; flat ones use the command word's colour for every vertex.
+ * Depth comes from the PGXP shadow of each DMA'd position word. */
+static void publish_triangle_extra(const int idx[3]) {
+    ShadowtowerTriangleExtra *extra = &g_shadowtower_triangle_extra;
+    const int shaded = (gp0_cmd_buf[0] >> 28) & 1;
+    extra->has_depth = gp0_cmd_source_addr != 0xFFFFFFFFu;
+    for (int i = 0; i < 3; i++) {
+        const int colour = shaded ? idx[i] - 1 : 0;
+        extra->rgb[i] = gp0_cmd_buf[colour] & 0xFFFFFFu;
+        extra->light[i] = gp0_cmd_source_addr == 0xFFFFFFFFu ? NULL
+            : shadowtower_light_lookup(gp0_cmd_source_addr + (uint32_t)colour * 4u, gp0_cmd_buf[colour]);
+        uint32_t addr = (gp0_cmd_source_addr + (uint32_t)idx[i] * 4u) & 0x1FFFFCu;
+        if (extra->has_depth &&
+            (!gte_precision_load_word(addr, gp0_cmd_buf[idx[i]], NULL, NULL, &extra->sz[i]) ||
+             extra->sz[i] == 0))
+            extra->has_depth = 0;
+    }
+    extra->valid = 1;
+}

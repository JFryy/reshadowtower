+/* The USA menu routine sets this byte to 1 on entry and 2 on exit.
+ * Confirm its two stores before trusting RAM that another executable may own. */
+static int shadowtower_menu_active(void) {
+    return psx_read_word(0x80042E74u) == 0xA046B6DAu &&
+           psx_read_word(0x8004316Cu) == 0xA062B6DAu &&
+           psx_read_byte(0x8018B6DAu) == 1;
+}
+
 static int ws_game_mode(void) {
